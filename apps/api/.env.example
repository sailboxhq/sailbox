# ── Required ────────────────────────────────────────────────────────
# Both must be set; the server refuses to start otherwise.
JWT_SECRET=change-me-to-a-random-string
SETUP_SECRET=change-me-to-a-random-string

# ── Server ──────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# SERVER_SHUTDOWN_TIMEOUT=15s

# Public URL of this instance. Used to build GitHub App callback and
# webhook URLs and team invitation links, so a wrong value breaks those
# flows even though the panel itself still works.
APP_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgres://sailbox:sailbox@localhost:5433/sailbox?sslmode=disable
# DATABASE_MAX_OPEN_CONNS=25
# DATABASE_MAX_IDLE_CONNS=5
# DATABASE_CONN_MAX_LIFETIME=5m

# ── Kubernetes ──────────────────────────────────────────────────────
# Both are unset by default, which runs the noop orchestrator: it logs what it
# would have done instead of touching a cluster — enough for working on the API
# or the UI without K3s installed. Point KUBECONFIG at a real cluster to drive
# one. (Production sets these on the container, not through this file.)
# KUBECONFIG=/etc/rancher/k3s/k3s.yaml
# K8S_IN_CLUSTER=false

# ── Tokens ──────────────────────────────────────────────────────────
# Access tokens are verified from their signature alone, so this is how long
# a revoked session (password change, role change, removed member) can still
# be used. Keep it short: the web client refreshes silently in the background.
# JWT_TOKEN_EXPIRY=15m
# JWT_REFRESH_EXPIRY=168h

# ── Sentry (optional — leave empty to disable) ──────────────────────
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
